  "metaRegistry": "https://w3id.org/ogc/bblocks/meta-register.json",
  "name": "Building Blocks - Activity Type Register",
  "abstract": "A general-purpose, engine- and format-agnostic vocabulary of Generic Profiles, \nindependent of any one project. \nA Generic Profile gives one or more related operations an abstract I/O signature (named roles and abstract types, no format, no size limit)\n",
  "description": "The description can be longer. Both **the abstract** *and the description* support Markdown,\nincluding [links](https://google.es).\n",
  "modified": "2026-10-30T09:59:37.917408",
