<bblocks://ogc.register.st-ml-activity-types> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "SpatioTemporal ML Activity Types Profile" ;
    dct:abstract "A profile of the SpatioTemporal Machine learning Activity Types Profile describing spatiotemporal machine learning training and inference runs, and registrable ML activity types, using the STAC MLM extension's task, framework/accelerator and input/output vocabulary."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-17T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/bblock/ogc.register.st-ml-activity-types> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/markdown/register/st-ml-activity-types/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/json-full/register/st-ml-activity-types/index.json> ],
        "The STAC Machine Learning Model (MLM) extension describes a model as a static artifact — a STAC Item or Collection with declared inputs, outputs and requirements — but has no notion of a particular run of that model. This block adds that: mlact:MLActivityType (with mlact:TrainingActivityType and mlact:InferenceActivityType sub-types) is a geoproc:GeoprocessingActivityType recording one execution, and so can be specialised into ML activity types held in an activity type register. It is also a rim:RegisterAction. In this ecosystem, running a model is itself a governed act — typically the one that adds a derived product to a register as a new rim:RegisterItem — so the run belongs in the same audit trail as any other register action. The activity's task, framework and accelerator are drawn from the MLM extension's own SKOS schemes rather than redefined, and its recorded inputs/outputs (mlact:ActivityInput / mlact:ActivityOutput, both prov:Entity) each declare via dct:conformsTo which of the model's own declared mlm:ModelInput/mlm:ModelOutput specifications they realise. Registered ML activity types must declare at least one mlact:ActivityInput sub-type as a used entity type, and registered inference types at least one mlact:ActivityOutput sub-type as a generated entity type."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.3" ;
    dct:modified "2026-10-28"^^xsd:date ;
    dct:source <https://github.com/ogcincubator/bblocks-stac/tree/master/_sources/extensions/mlm-ontology>,
        <https://github.com/stac-extensions/mlm/blob/main/README.md>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/ml-activity/STMLActivityType> ;
    skos:inScheme <https://geonovum-labs.github.io/activity-type-register/> ;
    skos:prefLabel "SpatioTemporal ML Activity Types Profile" ;
    skos:topConceptOf <https://geonovum-labs.github.io/activity-type-register/> ;
    dcat:keyword "MLM",
        "activity type",
        "machine learning",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/st-ml-activity-types/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/st-ml-activity-types/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.geoprocessing-activity-types> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/geoprocessing-activity-types/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/st-ml-activity-types/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.activity-type> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.mlm-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/mlm-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/st-ml-activity-types/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.rim.core-ontology> ;
            prof:hasArtifact <https://geonovum-labs.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.st-ml-activity-types> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/st-ml-activity-types/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    prof:isProfileOf <bblocks://ogc.register.geoprocessing-activity-types> ;
    bblocks:dependsOn <bblocks://ogc.contrib.stac.extensions.mlm-ontology>,
        <bblocks://ogc.register.geoprocessing-activity-types> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<https://www.w3.org/TR/prov-o/> rdfs:label "W3C PROV-O" .

<bblocks://ogc.register.geoprocessing-activity-types> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Geoprocessing Activity Types Profile" ;
    dct:abstract "A profile of the Activity Type Register Profile for geoprocessing activity types: registered sub-classes of geoproc:GeoprocessingActivityType, each required to use or generate at least one GeoSPARQL spatial data type."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/json-full/register/geoprocessing-activity-types/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/bblock/ogc.register.geoprocessing-activity-types> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/markdown/register/geoprocessing-activity-types/index.md> ],
        "Geoprocessing activities (reprojection, clipping, index computation, classification, model inference over imagery) are distinguished from other activities by the kind of data they use and produce. This block adds geoproc:GeoprocessingActivityType, a sub-class of acttype:ActivityType that every registered geoprocessing activity type specialises. It also constrains the related PROV object types such a type declares: at least one acttype:usedEntityType or acttype:generatedEntityType must be a GeoSPARQL 1.1 spatial type (geo:SpatialObject or geo:SpatialObjectCollection, or a sub-class of either). Further profiles, such as the ML Activity Types Profile, specialise geoproc:GeoprocessingActivityType in turn and add their own constraints."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.3" ;
    dct:modified "2026-10-28"^^xsd:date ;
    dct:source <https://docs.ogc.org/is/22-047r1/22-047r1.html>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:inScheme <https://geonovum-labs.github.io/activity-type-register/> ;
    skos:prefLabel "Geoprocessing Activity Types Profile" ;
    skos:topConceptOf <https://geonovum-labs.github.io/activity-type-register/> ;
    dcat:keyword "activity type",
        "geoprocessing",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.rim.core-ontology> ;
            prof:hasArtifact <https://geonovum-labs.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/geoprocessing-activity-types/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/geoprocessing-activity-types/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.activity-type> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.geoprocessing-activity-types> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/geoprocessing-activity-types/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/geoprocessing-activity-types/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/geoprocessing-activity-types/ontology.ttl> ;
            prof:hasRole role:specification ] ;
    prof:isProfileOf <bblocks://ogc.register.activity-type> ;
    bblocks:dependsOn <bblocks://ogc.model.cross-domain.geosparql>,
        <bblocks://ogc.register.activity-type> ;
    bblocks:hasSourceJsonLdContext <https://geonovum-labs.github.io/activity-type-register/_sources/geoprocessing-activity-types/context.jsonld> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed false .

<bblocks://ogc.register.activity-type> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Activity Type Register Profile" ;
    dct:abstract "A profile of the Registered Item Model for governed activity type records in the acttype:ActivityType hierarchy, with related PROV object types and an optional plan."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/json-full/register/activity-type/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/build/generateddocs/markdown/register/activity-type/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/activity-type-register/bblock/ogc.register.activity-type> ],
        "An activity type register governs activity types with identifiers, statuses and change history. Specific activity type classes specialise acttype:ActivityType, a sub-class of rim:RegisterItem. Registered types may be classes used to type individual activity records; those records also inherit register item requirements. Every activity type record uses acttype:activityTypeItemClass and belongs to the acttype:ActivityType hierarchy through rdf:type. Related entity, agent and activity types and an optional prov:Plan describe the expected activity. Further profiles specialise the root and constrain these related types."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.3" ;
    dct:modified "2026-10-28"^^xsd:date ;
    dct:source <https://www.opmw.org/model/p-plan/>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/activity-type/ActivityType> ;
    skos:inScheme <https://geonovum-labs.github.io/activity-type-register/> ;
    skos:prefLabel "Activity Type Register Profile" ;
    skos:topConceptOf <https://geonovum-labs.github.io/activity-type-register/> ;
    dcat:keyword "activity type",
        "plan",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.rim.core-ontology> ;
            prof:hasArtifact <https://geonovum-labs.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/activity-type/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/activity-type/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/activity-type/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/build/annotated/register/activity-type/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.register.activity-type> ;
            prof:hasArtifact <https://geonovum-labs.github.io/activity-type-register/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    prof:isProfileOf <bblocks://ogc.rim.core-ontology>,
        <bblocks://ogc.rim.schemas.register-item> ;
    bblocks:dependsOn <bblocks://ogc.model.cross-domain.prov>,
        <bblocks://ogc.rim.schemas.register-item>,
        <bblocks://ogc.rim.schemas.register-item-class> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<https://geonovum-labs.github.io/activity-type-register/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Activity Type Register" ;
    dct:abstract """A general-purpose, engine- and format-agnostic vocabulary of Generic Profiles, 
independent of any one project. 
A Generic Profile gives one or more related operations an abstract I/O signature (named roles and abstract types, no format, no size limit)
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """The description can be longer. Both **the abstract** *and the description* support Markdown,
including [links](https://google.es).
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-10-28T18:31:59.639468"^^xsd:dateTime ;
    owl:imports <https://geonovum-labs.github.io/registered-item-model/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.register.activity-type>,
        <bblocks://ogc.register.geoprocessing-activity-types>,
        <bblocks://ogc.register.st-ml-activity-types> ;
    skos:prefLabel "Building Blocks - Activity Type Register" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://geonovum-labs.github.io/activity-type-register/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://geonovum-labs.github.io/activity-type-register/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://geonovum-labs.github.io/activity-type-register/build/bblocks.jsonld> ] ;
    foaf:homepage <https://geonovum-labs.github.io/activity-type-register/> ;
    bblocks:hasValidationReport <https://geonovum-labs.github.io/activity-type-register/build/tests/report.html> .

